---
export const prerender = false;

import { supabase } from "../../db/supabase";

const ADMIN_USER = import.meta.env.ADMIN_USER;
const ADMIN_PASS = import.meta.env.ADMIN_PASS;

let authenticated = false;
let messages: any[] = [];
let error = "";

// Check cookie
const sessionCookie = Astro.cookies.get("admin_session")?.value;
if (sessionCookie === "authenticated") {
  authenticated = true;
}

// Handle login POST
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");

  if (action === "login") {
    const user = formData.get("username");
    const pass = formData.get("password");

    if (user === ADMIN_USER && pass === ADMIN_PASS) {
      authenticated = true;
      Astro.cookies.set("admin_session", "authenticated", {
        httpOnly: true,
        secure: true,
        sameSite: "strict",
        maxAge: 60 * 60 * 4, // 4 hours
        path: "/",
      });
    } else {
      error = "Invalid credentials.";
    }
  }

  if (action === "logout") {
    authenticated = false;
    Astro.cookies.delete("admin_session", { path: "/" });
  }

  if (action === "delete") {
    const id = formData.get("id");
    if (id && authenticated) {
      await supabase.from("messages").delete().eq("id", id);
    }
  }
}

// Fetch messages if logged in
if (authenticated) {
  const result = await supabase
    .from("messages")
    .select("*")
    .order("created_at", { ascending: false });
  messages = result.data || [];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — Messages</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: #0a0a0f;
        color: #e8e8f0;
        font-family: "Syne", sans-serif;
        min-height: 100vh;
      }
      .mono { font-family: "Space Mono", monospace; }
      .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem; }
      .accent { color: #00e5a0; }
      .muted { color: #6a6a80; }
      .card {
        background: #16161f;
        border: 1px solid rgba(255,255,255,0.07);
        padding: 1.5rem;
        margin-bottom: 1rem;
      }
      .card:hover { border-color: rgba(0,229,160,0.2); }
      input {
        background: #16161f;
        border: 1px solid rgba(255,255,255,0.07);
        color: #e8e8f0;
        padding: 0.75rem 1rem;
        font-family: "Space Mono", monospace;
        font-size: 0.875rem;
        width: 100%;
        outline: none;
      }
      input:focus { border-color: #00e5a0; }
      .btn {
        background: #00e5a0;
        color: #0a0a0f;
        font-family: "Space Mono", monospace;
        font-size: 0.875rem;
        font-weight: 700;
        padding: 0.75rem 1.5rem;
        border: none;
        cursor: pointer;
      }
      .btn:hover { filter: brightness(1.1); }
      .btn-ghost {
        background: none;
        color: #6a6a80;
        border: 1px solid rgba(255,255,255,0.07);
        font-family: "Space Mono", monospace;
        font-size: 0.75rem;
        padding: 0.4rem 0.8rem;
        cursor: pointer;
      }
      .btn-ghost:hover { color: #ff4444; border-color: #ff4444; }
      .btn-logout {
        background: none;
        color: #6a6a80;
        border: 1px solid rgba(255,255,255,0.07);
        font-family: "Space Mono", monospace;
        font-size: 0.75rem;
        padding: 0.4rem 0.8rem;
        cursor: pointer;
      }
      .btn-logout:hover { color: #00e5a0; border-color: #00e5a0; }
      .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
      .error { color: #ff4444; font-family: "Space Mono", monospace; font-size: 0.75rem; margin-top: 0.5rem; }
      .meta { display: flex; gap: 1rem; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; }
      .badge { font-size: 0.65rem; background: rgba(0,229,160,0.1); color: #00e5a0; padding: 0.15rem 0.5rem; font-family: "Space Mono", monospace; }
      .msg-body { color: #e8e8f0; font-size: 0.9rem; line-height: 1.6; white-space: pre-wrap; }
      .empty { text-align: center; padding: 3rem; color: #6a6a80; }
      .login-box { max-width: 360px; margin: 15vh auto; }
    </style>
  </head>
  <body>
    <div class="container">
      {!authenticated ? (
        <div class="login-box">
          <h1 class="mono accent" style="font-size: 1.2rem; margin-bottom: 0.5rem;">MK_ admin</h1>
          <p class="muted mono" style="font-size: 0.75rem; margin-bottom: 1.5rem;">Enter credentials to view messages.</p>
          <form method="POST" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <input type="hidden" name="action" value="login" />
            <input type="text" name="username" placeholder="Username" required />
            <input type="password" name="password" placeholder="Password" required />
            <button type="submit" class="btn">Log in</button>
          </form>
          {error && <p class="error">{error}</p>}
        </div>
      ) : (
        <>
          <div class="header">
            <div>
              <h1 class="mono accent" style="font-size: 1.2rem;">MK_ messages</h1>
              <p class="muted mono" style="font-size: 0.7rem; margin-top: 0.25rem;">{messages.length} message{messages.length !== 1 ? "s" : ""}</p>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
              <a href="/" class="btn-logout" style="text-decoration: none;">Back to site</a>
              <form method="POST" style="display: inline;">
                <input type="hidden" name="action" value="logout" />
                <button type="submit" class="btn-logout">Log out</button>
              </form>
            </div>
          </div>

          {messages.length === 0 ? (
            <div class="empty">
              <p class="mono muted">No messages yet.</p>
            </div>
          ) : (
            messages.map((msg) => (
              <div class="card">
                <div class="meta">
                  <span style="font-weight: 600;">{msg.name}</span>
                  <span class="muted mono" style="font-size: 0.75rem;">{msg.email}</span>
                  <span class="badge">
                    {new Date(msg.created_at).toLocaleDateString("en-MY", {
                      year: "numeric", month: "short", day: "numeric",
                      hour: "2-digit", minute: "2-digit",
                    })}
                  </span>
                  <form method="POST" style="margin-left: auto;">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={msg.id} />
                    <button type="submit" class="btn-ghost" onclick="return confirm('Delete this message?')">delete</button>
                  </form>
                </div>
                <p class="msg-body">{msg.message}</p>
              </div>
            ))
          )}
        </>
      )}
    </div>
  </body>
</html>
