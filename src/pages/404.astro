---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Page not found · Moaaz Khamis" noindex>
  <section class="flex min-h-[80svh] flex-col items-start justify-center gap-6 mx-auto max-w-6xl px-5 pt-24 sm:px-6 md:px-12">
    <p class="font-mono text-sm text-accent">&gt; error 404</p>
    <h1 class="font-sans text-4xl font-extrabold text-white md:text-6xl">Page not found</h1>
    <p class="max-w-md leading-relaxed text-muted">The page you're looking for doesn't exist or has moved.</p>
    <a
      href="/"
      class="inline-flex items-center border border-accent px-6 py-3 font-mono text-sm text-accent transition-colors duration-300 hover:bg-accent hover:text-canvas"
    >
      Back home
    </a>
  </section>
</BaseLayout>
