---
interface Props {
  size?: "sm" | "md";
}

const { size = "sm" } = Astro.props;
---

<li
  class:list={[
    "font-mono",
    size === "sm"
      ? "border border-border px-2 py-0.5 text-[11px] text-muted"
      : "cursor-default border border-border bg-surface px-3 py-1.5 text-xs text-primary transition-colors duration-300 hover:border-accent hover:bg-accent/5 hover:text-accent",
  ]}
>
  <slot />
</li>
