---
import TiltCard from "./TiltCard.astro";
import Tag from "./Tag.astro";
import ExternalLink from "./ExternalLink.astro";
import type { Project } from "../../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const isShipped = project.status === "shipped";
---

<TiltCard surfaceClass="p-5 sm:p-6">
  <article class="flex h-full flex-col gap-3">
    <span class="font-mono text-xs text-muted">
      {String(index).padStart(2, "0")}/ {project.role}
    </span>
    <h3 class="font-sans text-lg font-bold text-white">{project.title}</h3>
    <p class="flex-1 text-sm leading-relaxed text-muted">{project.description}</p>

    {
      project.links && project.links.length > 0 && (
        <div class="mt-1 flex flex-wrap gap-2">
          {project.links.map((link) => (
            <ExternalLink href={link.href} variant={link.variant}>
              {link.label}
            </ExternalLink>
          ))}
        </div>
      )
    }

    <div class="mt-1 flex items-center gap-2">
      <span
        class:list={[
          "rounded-sm px-2 py-0.5 font-mono text-xs",
          isShipped ? "bg-accent/10 text-accent" : "bg-accent-blue/10 text-accent-blue",
        ]}
      >
        {project.status}
      </span>
      <span class="font-mono text-xs text-muted">{project.year}</span>
    </div>

    <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Technologies">
      {project.tags.map((tag) => <Tag>{tag}</Tag>)}
    </ul>
  </article>
</TiltCard>
