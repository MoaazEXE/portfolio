---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  id: string;
  /** Two-digit index shown in the eyebrow, e.g. "01". */
  index: string;
  /** Lower-case label shown in the eyebrow, e.g. "about". */
  label: string;
  title: string;
}

const { id, index, label, title, class: className, ...rest } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={["mx-auto w-full max-w-6xl px-5 py-20 sm:px-6 md:px-12 md:py-24", className]}
  {...rest}
>
  <header class="mb-10 md:mb-12" data-reveal>
    <span class="mb-2 block font-mono text-xs tracking-[0.2em] text-muted uppercase">
      // {index} — {label}
    </span>
    <h2 id={headingId} class="font-sans text-3xl font-bold text-white md:text-4xl">
      {title}
    </h2>
    <span class="mt-3 block h-1 w-12 bg-accent" aria-hidden="true"></span>
  </header>

  <slot />
</section>
