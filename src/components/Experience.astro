---
import { experiences } from "../data/experience";
---

<section id="experience" class="px-6 md:px-12 py-24 max-w-6xl mx-auto">
  <div class="fade-in-up mb-12">
    <span class="font-mono text-muted text-xs tracking-[0.2em] uppercase block mb-2">// 04 — experience</span>
    <h2 class="font-sans font-bold text-3xl md:text-4xl text-white">
      Timeline
      <span class="block w-12 h-1 bg-accent mt-3"></span>
    </h2>
  </div>

  <div class="relative ml-4" id="timeline">
    <!-- Vertical line (animated fill) -->
    <div class="absolute left-0 top-0 bottom-0 w-px bg-border"></div>
    <div class="timeline-progress absolute left-0 top-0 w-px bg-accent" style="height: 0%; transition: height 0.8s ease-out;"></div>

    <div class="flex flex-col gap-12">
      {
        experiences.map((exp) => (
          <div class="timeline-entry group relative pl-8 fade-in-up cursor-default">
            {/* Diamond bullet — pulses on hover */}
            <div class="absolute left-0 top-1 w-3 h-3 bg-accent -translate-x-[6.5px] rotate-45 transition-all duration-300 group-hover:scale-150 group-hover:shadow-[0_0_12px_rgba(0,229,160,0.6)]" />

            {/* Content card — slides and glows on hover */}
            <div class="relative p-4 -ml-1 border border-transparent rounded-sm transition-all duration-300 group-hover:bg-card group-hover:border-border group-hover:translate-x-2">
              {/* Glow */}
              <div class="absolute -inset-px rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10 blur-md bg-accent/10 pointer-events-none"></div>

              <span class="font-mono text-accent text-xs tracking-wide block mb-1">{exp.date}</span>
              <h3 class="font-sans font-bold text-white text-lg transition-colors duration-300 group-hover:text-accent">{exp.role}</h3>
              <span class="text-muted text-sm block mb-2">{exp.org}</span>
              <p class="text-muted text-sm leading-relaxed">{exp.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Animate the timeline progress line as user scrolls
  const timeline = document.getElementById("timeline");
  const progressBar = timeline?.querySelector(".timeline-progress") as HTMLElement;

  if (timeline && progressBar) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const rect = timeline.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            const scrolled = Math.min(
              Math.max((viewportHeight - rect.top) / rect.height, 0),
              1
            );
            progressBar.style.height = `${scrolled * 100}%`;
          }
        });
      },
      { threshold: Array.from({ length: 20 }, (_, i) => i / 19) }
    );
    observer.observe(timeline);

    window.addEventListener("scroll", () => {
      const rect = timeline.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const scrolled = Math.min(
        Math.max((viewportHeight - rect.top) / rect.height, 0),
        1
      );
      progressBar.style.height = `${scrolled * 100}%`;
    });
  }
</script>
