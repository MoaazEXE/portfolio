---
import { Image } from 'astro:assets';
import profilePhoto from '../assests/MyPhoto.jpg';
---

<section
  class="relative min-h-screen flex items-center px-6 md:px-12 pt-24 pb-16 overflow-hidden"
>
  <!-- Background grid -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: linear-gradient(rgba(0,229,160,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0,229,160,0.03) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 40%, transparent 100%);"
  >
  </div>

  <div class="relative z-10 w-full max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 items-center">
    <div class="flex flex-col gap-6">
      <!-- Tag line -->
      <div class="flex items-center gap-3">
        <div class="w-8 h-px bg-accent"></div>
        <span class="font-mono text-accent text-sm tracking-wide">&gt; available for opportunities</span>
      </div>

      <!-- Name -->
      <h1
        class="font-sans font-[800] text-white leading-[0.95] tracking-[-2px]"
        style="font-size: clamp(3rem, 8vw, 6.5rem);"
      >
        Moaaz<br />Khamis
      </h1>

      <!-- Role -->
      <p
        class="font-mono text-accent tracking-wide"
        style="font-size: clamp(1rem, 2.5vw, 1.4rem);"
      >
        &gt; Software Engineer
      </p>

      <!-- Description -->
      <p class="text-muted max-w-[540px] leading-relaxed">
        Building digital products that bridge cultures and solve real problems.
        Based in Kuala Lumpur, studying at Universiti Malaya.
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap gap-4 mt-2">
        <a
          href="#projects"
          class="inline-block bg-accent text-base font-mono text-sm font-bold px-6 py-3 hover:brightness-110 transition-all duration-300"
          style="clip-path: polygon(0 0, 100% 0, 95% 100%, 0% 100%);"
        >
          View my work
        </a>
        <a
          href="#contact"
          class="inline-block border border-muted text-primary font-mono text-sm px-6 py-3 hover:border-accent hover:text-accent transition-all duration-300"
        >
          Get in touch
        </a>
      </div>

      <!-- Stats -->
      <div class="flex flex-wrap gap-8 mt-6">
        <div class="border-l-2 border-accent pl-4">
          <span class="text-white font-sans font-semibold text-lg">2+</span>
          <span class="text-muted text-sm ml-1">years coding</span>
        </div>
        <div class="border-l-2 border-accent pl-4">
          <span class="text-white font-sans font-semibold text-lg">7</span>
          <span class="text-muted text-sm ml-1">projects</span>
        </div>
        <div class="border-l-2 border-accent pl-4">
          <span class="text-white font-sans font-semibold text-lg">2</span>
          <span class="text-muted text-sm ml-1">active roles</span>
        </div>
      </div>
    </div>

    <div
      class="relative w-[280px] aspect-[3/4] border-2 border-accent p-1 mx-auto lg:mx-0 group"
      style="background: rgba(0,229,160,0.03);"
    >
      <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-accent z-10 transition-transform duration-300 group-hover:-translate-x-1 group-hover:-translate-y-1"></div>
      <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-accent z-10 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"></div>
      <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-accent z-10 transition-transform duration-300 group-hover:-translate-x-1 group-hover:translate-y-1"></div>
      <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-accent z-10 transition-transform duration-300 group-hover:translate-x-1 group-hover:translate-y-1"></div>
      
      <Image 
        src={profilePhoto} 
        alt="Moaaz Khamis - Software Engineer" 
        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
      />
    </div>
  </div>
</section>
