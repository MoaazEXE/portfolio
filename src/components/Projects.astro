---
import { projects } from "../data/projects";
---

<section id="projects" class="px-6 md:px-12 py-24 max-w-6xl mx-auto">
  <div class="fade-in-up mb-12">
    <span class="font-mono text-muted text-xs tracking-[0.2em] uppercase block mb-2">// 02 — projects</span>
    <h2 class="font-sans font-bold text-3xl md:text-4xl text-white">
      What I've Built
      <span class="block w-12 h-1 bg-accent mt-3"></span>
    </h2>
  </div>

  <!-- Filters -->
  <div class="flex gap-3 mb-8 fade-in-up">
    <button
      class="filter-btn active font-mono text-xs uppercase tracking-[0.15em] px-4 py-2 border border-border text-muted hover:text-accent hover:border-accent transition-all duration-300"
      data-filter="all"
    >
      All
    </button>
    <button
      class="filter-btn font-mono text-xs uppercase tracking-[0.15em] px-4 py-2 border border-border text-muted hover:text-accent hover:border-accent transition-all duration-300"
      data-filter="shipped"
    >
      Shipped
    </button>
    <button
      class="filter-btn font-mono text-xs uppercase tracking-[0.15em] px-4 py-2 border border-border text-muted hover:text-accent hover:border-accent transition-all duration-300"
      data-filter="in progress"
    >
      In Progress
    </button>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
    {
      projects.map((project, i) => (
        <div class="tilt-wrapper perspective-[800px] fade-in-up" data-status={project.status}>
          <div
            class="project-card group relative bg-card border border-border p-6 flex flex-col gap-3 transition-transform duration-200 ease-out will-change-transform"
            style="transform-style: preserve-3d;"
          >
            {/* Glow behind card */}
            <div class="absolute -inset-[1px] rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10 blur-md bg-accent/15 pointer-events-none" />
            <div class="absolute -inset-px rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10 bg-gradient-to-br from-accent/10 via-transparent to-accent-blue/10 pointer-events-none" />

            <span class="font-mono text-xs text-muted">
              {String(i + 1).padStart(2, "0")}/ {project.role}
            </span>
            <h3 class="font-sans font-bold text-lg text-white">{project.title}</h3>
            <p class="text-muted text-sm leading-relaxed flex-1">{project.description}</p>

            {project.id === "digital-umisa" && (
              <a
                href="https://umisa.net"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 mt-1 px-3 py-1.5 bg-accent/10 border border-accent/30 text-accent font-mono text-xs hover:bg-accent/20 hover:border-accent/60 transition-all duration-300 w-fit"
              >
                <span>View the website</span>
                <span class="font-bold">UMISA.net</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline-block">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </a>
            )}

            {project.id === "settle" && (
              <a
                href="https://settle-moexe.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 mt-1 px-3 py-1.5 bg-accent/10 border border-accent/30 text-accent font-mono text-xs hover:bg-accent/20 hover:border-accent/60 transition-all duration-300 w-fit"
              >
                <span>Visit</span>
                <span class="font-bold">Settle</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline-block">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </a>
            )}

            <div class="flex items-center gap-2 mt-1">
              <span
                class={`font-mono text-xs px-2 py-0.5 rounded-sm ${
                  project.status === "shipped"
                    ? "text-accent bg-accent/10"
                    : "text-accent-blue bg-accent-blue/10"
                }`}
              >
                {project.status}
              </span>
              <span class="font-mono text-xs text-muted">{project.year}</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-2">
              {project.tags.map((tag) => (
                <span class="font-mono text-[10px] text-muted border border-border px-2 py-0.5">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Filters
  document.querySelectorAll(".filter-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach((b) => b.classList.remove("active", "!text-accent", "!border-accent"));
      btn.classList.add("active", "!text-accent", "!border-accent");

      const filter = (btn as HTMLElement).dataset.filter;
      document.querySelectorAll(".tilt-wrapper").forEach((wrapper) => {
        const status = (wrapper as HTMLElement).dataset.status;
        if (filter === "all" || status === filter) {
          (wrapper as HTMLElement).style.display = "";
        } else {
          (wrapper as HTMLElement).style.display = "none";
        }
      });
    });
  });

  const firstBtn = document.querySelector(".filter-btn.active");
  firstBtn?.classList.add("!text-accent", "!border-accent");

  // 3D tilt on hover
  document.querySelectorAll(".tilt-wrapper").forEach((wrapper) => {
    const card = wrapper.querySelector(".project-card") as HTMLElement;
    if (!card) return;

    wrapper.addEventListener("mousemove", (e) => {
      const ev = e as MouseEvent;
      const rect = card.getBoundingClientRect();
      const x = ev.clientX - rect.left;
      const y = ev.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = ((y - centerY) / centerY) * -8;
      const rotateY = ((x - centerX) / centerX) * 8;

      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.03)`;
    });

    wrapper.addEventListener("mouseleave", () => {
      card.style.transform = "perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)";
    });
  });
</script>
