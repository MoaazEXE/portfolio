---
import { skillGroups } from "../data/skills";
---

<section id="skills" class="px-6 md:px-12 py-24 max-w-6xl mx-auto">
  <div class="fade-in-up mb-12">
    <span class="font-mono text-muted text-xs tracking-[0.2em] uppercase block mb-2">// 03 — skills</span>
    <h2 class="font-sans font-bold text-3xl md:text-4xl text-white">
      Tech Stack
      <span class="block w-12 h-1 bg-accent mt-3"></span>
    </h2>
  </div>

  <div id="skills-grid" class="relative grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Spotlight overlay that follows cursor across the grid -->
    <div id="skills-spotlight" class="pointer-events-none absolute inset-0 z-10 opacity-0 transition-opacity duration-500" style="background: radial-gradient(400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0,229,160,0.06), transparent 60%);"></div>

    {
      skillGroups.map((group) => (
        <div class="skill-tilt perspective-[800px] fade-in-up">
          <div
            class="skill-card group relative bg-card border border-border p-6 flex flex-col gap-5 transition-transform duration-200 ease-out will-change-transform"
            style="transform-style: preserve-3d;"
          >
            {/* Glow behind card */}
            <div class="absolute -inset-[1px] rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10 blur-md bg-accent/15 pointer-events-none" />
            <div class="absolute -inset-px rounded-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10 bg-gradient-to-br from-accent/10 via-transparent to-accent-blue/10 pointer-events-none" />

            <h3 class="font-mono text-accent text-sm font-bold uppercase tracking-wide">{group.name}</h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="skill-pill font-mono text-xs text-primary bg-surface border border-border px-3 py-1.5 transition-all duration-300 hover:border-accent hover:text-accent hover:bg-accent/5 hover:scale-105 cursor-default">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const grid = document.getElementById("skills-grid");
  const spotlight = document.getElementById("skills-spotlight");

  if (grid && spotlight) {
    grid.addEventListener("mouseenter", () => {
      spotlight.style.opacity = "1";
    });
    grid.addEventListener("mouseleave", () => {
      spotlight.style.opacity = "0";
    });
    grid.addEventListener("mousemove", (e) => {
      const rect = grid.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      spotlight.style.setProperty("--mouse-x", x + "px");
      spotlight.style.setProperty("--mouse-y", y + "px");
    });
  }

  // 3D tilt on skill cards
  document.querySelectorAll(".skill-tilt").forEach((wrapper) => {
    const card = wrapper.querySelector(".skill-card") as HTMLElement;
    if (!card) return;

    wrapper.addEventListener("mousemove", (e) => {
      const ev = e as MouseEvent;
      const rect = card.getBoundingClientRect();
      const x = ev.clientX - rect.left;
      const y = ev.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = ((y - centerY) / centerY) * -6;
      const rotateY = ((x - centerX) / centerX) * 6;

      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });

    wrapper.addEventListener("mouseleave", () => {
      card.style.transform = "perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)";
    });
  });
</script>
