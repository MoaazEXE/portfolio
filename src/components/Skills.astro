---
import { skillGroups } from "../data/skills";
---

<section id="skills" class="px-6 md:px-12 py-24 max-w-6xl mx-auto">
  <div class="fade-in-up mb-12">
    <span class="font-mono text-muted text-xs tracking-[0.2em] uppercase block mb-2">// 03 — skills</span>
    <h2 class="font-sans font-bold text-3xl md:text-4xl text-white">
      Tech Stack
      <span class="block w-12 h-1 bg-accent mt-3"></span>
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    {
      skillGroups.map((group) => (
        <div class="bg-card border border-border p-6 flex flex-col gap-4 fade-in-up">
          <h3 class="font-mono text-accent text-sm font-bold uppercase tracking-wide">{group.name}</h3>
          <div class="flex flex-col gap-3">
            {group.skills.map((skill) => (
              <div class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0" />
                <span class="text-primary text-sm flex-1">{skill}</span>
                <div class="w-20 h-1 bg-surface rounded-full overflow-hidden">
                  <div class="h-full bg-accent/40 rounded-full" style="width: 75%;" />
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
