---

---

<section id="contact" class="px-6 md:px-12 py-24 max-w-6xl mx-auto">
  <div class="fade-in-up mb-12">
    <span class="font-mono text-muted text-xs tracking-[0.2em] uppercase block mb-2">// 05 — contact</span>
    <h2 class="font-sans font-bold text-3xl md:text-4xl text-white">
      Let's Build Something
      <span class="block w-12 h-1 bg-accent mt-3"></span>
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
    <!-- Left: intro + links -->
    <div class="flex flex-col gap-6 fade-in-up">
      <p class="text-muted leading-relaxed">
        I'm always open to new opportunities, collaborations, and interesting conversations. Whether you have a project idea, an internship opportunity, or just want to connect — reach out.
      </p>

      <div class="flex flex-col gap-3">
        <a
          href="mailto:mouazkhamis@gmail.com"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">email</span>
          <span class="text-sm">mouazkhamis@gmail.com</span>
        </a>
        <a
          href="https://linkedin.com/in/mouazkhamis"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">linkedin</span>
          <span class="text-sm">mouazkhamis</span>
        </a>
        <a
          href="https://github.com/mouazkhamis"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">github</span>
          <span class="text-sm">mouazkhamis</span>
        </a>
        <a
          href="https://wa.me/60123456789"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">whatsapp</span>
          <span class="text-sm">Moaaz Khamis</span>
        </a>
        <a
          href="https://instagram.com/mouazkhamis"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">instagram</span>
          <span class="text-sm">mouazkhamis</span>
        </a>
      </div>
    </div>

    <!-- Right: form -->
    <div class="flex flex-col gap-4 fade-in-up">
      <form class="flex flex-col gap-4">
        <input
          type="text"
          placeholder="Name"
          disabled
          class="bg-card border border-border text-primary placeholder-muted px-4 py-3 font-mono text-sm focus:outline-none focus:border-accent transition-colors duration-300 disabled:opacity-50"
        />
        <input
          type="email"
          placeholder="Email"
          disabled
          class="bg-card border border-border text-primary placeholder-muted px-4 py-3 font-mono text-sm focus:outline-none focus:border-accent transition-colors duration-300 disabled:opacity-50"
        />
        <textarea
          placeholder="Message"
          rows="5"
          disabled
          class="bg-card border border-border text-primary placeholder-muted px-4 py-3 font-mono text-sm focus:outline-none focus:border-accent transition-colors duration-300 resize-none disabled:opacity-50"
        ></textarea>
        <button
          type="submit"
          disabled
          class="bg-accent text-base font-mono text-sm font-bold px-6 py-3 hover:brightness-110 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
          style="clip-path: polygon(0 0, 100% 0, 95% 100%, 0% 100%);"
        >
          Send message
        </button>
      </form>
      <p class="font-mono text-xs text-muted">
        Form coming soon — reach out directly via email or WhatsApp for now.
      </p>
    </div>
  </div>
</section>
