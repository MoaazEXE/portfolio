---

<section id="contact" class="px-6 md:px-12 py-24 max-w-6xl mx-auto">
  <div class="fade-in-up mb-12">
    <span class="font-mono text-muted text-xs tracking-[0.2em] uppercase block mb-2">// 05 — contact</span>
    <h2 class="font-sans font-bold text-3xl md:text-4xl text-white">
      Let's Build Something
      <span class="block w-12 h-1 bg-accent mt-3"></span>
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
    <!-- Left: intro + links -->
    <div class="flex flex-col gap-6 fade-in-up">
      <p class="text-muted leading-relaxed">
        I'm always open to new opportunities, collaborations, and interesting conversations. Whether you have a project idea, an internship opportunity, or just want to connect — reach out.
      </p>

      <div class="flex flex-col gap-3">
        <a
          href="mailto:mouazkhamis@gmail.com"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">email</span>
          <span class="text-sm">mouazkhamis@gmail.com</span>
        </a>
        <a
          href="https://www.linkedin.com/in/moaaz-khamis-a24309332/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">linkedin</span>
          <span class="text-sm">Moaaz Khamis</span>
        </a>
        <a
          href="https://github.com/MoaazEXE"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">github</span>
          <span class="text-sm">MoaazEXE</span>
        </a>
        <a
          href="https://wa.me/601137210528"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">whatsapp</span>
          <span class="text-sm">Moaaz Khamis</span>
        </a>
        <a
          href="https://instagram.com/Moaaz.EXE"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-primary hover:text-accent transition-colors duration-300 group"
        >
          <span class="font-mono text-xs text-muted group-hover:text-accent w-16">instagram</span>
          <span class="text-sm">Moaaz.EXE</span>
        </a>
      </div>
    </div>

    <!-- Right: form -->
    <div class="flex flex-col gap-4 fade-in-up">
      <form id="contact-form" class="flex flex-col gap-4">
        <input
          type="text"
          name="name"
          placeholder="Name"
          required
          class="bg-card border border-border text-primary placeholder-muted px-4 py-3 font-mono text-sm focus:outline-none focus:border-accent transition-colors duration-300"
        />
        <input
          type="email"
          name="email"
          placeholder="Email"
          required
          class="bg-card border border-border text-primary placeholder-muted px-4 py-3 font-mono text-sm focus:outline-none focus:border-accent transition-colors duration-300"
        />
        <textarea
          name="message"
          placeholder="Message"
          rows="5"
          required
          class="bg-card border border-border text-primary placeholder-muted px-4 py-3 font-mono text-sm focus:outline-none focus:border-accent transition-colors duration-300 resize-none"
        ></textarea>
        <button
          type="submit"
          id="contact-submit"
          class="bg-accent text-base font-mono text-sm font-bold px-6 py-3 hover:brightness-110 transition-all duration-300"
          style="clip-path: polygon(0 0, 100% 0, 95% 100%, 0% 100%);"
        >
          Send message
        </button>
      </form>
      <p id="contact-status" class="font-mono text-xs text-muted hidden"></p>
    </div>
  </div>
</section>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_KEY
  );

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("contact-status") as HTMLElement;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const name = formData.get("name") as string;
    const email = formData.get("email") as string;
    const message = formData.get("message") as string;

    submitBtn.textContent = "Sending...";
    submitBtn.disabled = true;

    const { error } = await supabase.from("messages").insert([
      { name, email, message },
    ]);

    status.classList.remove("hidden");

    if (error) {
      status.textContent = "Something went wrong. Please try email or WhatsApp instead.";
      status.classList.add("text-red-400");
      status.classList.remove("text-accent");
    } else {
      status.textContent = "Message sent! I'll get back to you soon.";
      status.classList.add("text-accent");
      status.classList.remove("text-red-400");
      form.reset();
    }

    submitBtn.textContent = "Send message";
    submitBtn.disabled = false;
  });
</script>
