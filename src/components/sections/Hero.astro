---
import { Image } from "astro:assets";
import Icon from "../ui/Icon.astro";
import profilePhoto from "../../assets/profile.jpg";
import { site } from "../../data/site";
import { projects } from "../../data/projects";
import { activeRoles } from "../../data/experience";

const stats = [
  { value: "2+", label: "years coding" },
  { value: String(projects.length), label: "projects" },
  { value: String(activeRoles.length), label: "active roles" },
];

const [firstName, lastName] = site.name.split(" ");
---

<section
  id="top"
  class="relative flex min-h-svh items-center overflow-hidden px-5 pt-24 pb-16 sm:px-6 md:px-12"
>
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-12 lg:grid-cols-[1fr_auto]"
  >
    <div class="flex min-w-0 flex-col gap-6">
      <p class="flex items-center gap-3 font-mono text-sm tracking-wide text-accent">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        &gt; open to opportunities &amp; collaborations
      </p>

      <h1 class="hero-name font-sans leading-[0.95] font-extrabold tracking-[-0.03em] text-white">
        {firstName}<br />{lastName}
      </h1>

      <p class="hero-role font-mono tracking-wide text-accent">&gt; {site.role}</p>

      <p class="max-w-[540px] leading-relaxed text-muted">
        Contributing to and maintaining full-stack products and the data platforms that power them.
        Based in Kuala Lumpur — studying at Universiti Malaya and working as a software and data
        engineer at Rotate Asia.
      </p>

      <div class="mt-2 flex flex-wrap gap-3 sm:gap-4">
        <a
          href="#projects"
          class="btn-slant inline-flex items-center bg-accent px-6 py-3 font-mono text-sm font-bold text-canvas transition-[filter] duration-300 hover:brightness-110"
        >
          View my work
        </a>
        <a
          href={site.cvUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-accent px-6 py-3 font-mono text-sm text-accent transition-colors duration-300 hover:bg-accent hover:text-canvas"
        >
          <Icon name="file" />
          View CV
          <span class="sr-only">(PDF, opens in a new tab)</span>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center border border-muted px-6 py-3 font-mono text-sm text-primary transition-colors duration-300 hover:border-accent hover:text-accent"
        >
          Get in touch
        </a>
      </div>

      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
        {
          stats.map((stat) => (
            <div class="flex flex-row-reverse items-baseline gap-1.5 border-l-2 border-accent pl-4">
              <dt class="text-sm text-muted">{stat.label}</dt>
              <dd class="font-sans text-lg font-semibold text-white">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure
      class="group relative mx-auto aspect-[3/4] w-full max-w-[280px] border-2 border-accent bg-accent/[0.03] p-1 lg:mx-0"
    >
      <span class="corner top-0 left-0 border-t-2 border-l-2 group-hover:-translate-x-1 group-hover:-translate-y-1"></span>
      <span class="corner top-0 right-0 border-t-2 border-r-2 group-hover:translate-x-1 group-hover:-translate-y-1"></span>
      <span class="corner bottom-0 left-0 border-b-2 border-l-2 group-hover:-translate-x-1 group-hover:translate-y-1"></span>
      <span class="corner right-0 bottom-0 border-r-2 border-b-2 group-hover:translate-x-1 group-hover:translate-y-1"></span>
      <Image
        src={profilePhoto}
        alt={`Portrait of ${site.name}`}
        widths={[280, 560]}
        sizes="280px"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </figure>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(rgb(0 229 160 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(0 229 160 / 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 40%, transparent 100%);
  }

  .hero-name {
    font-size: clamp(2.75rem, 11vw, 6.5rem);
  }

  .hero-role {
    font-size: clamp(1rem, 2.5vw, 1.4rem);
  }

  .btn-slant {
    clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
    padding-right: 1.75rem;
  }

  .corner {
    position: absolute;
    z-index: 10;
    width: 1rem;
    height: 1rem;
    border-color: var(--color-accent);
    pointer-events: none;
    transition: translate 0.3s ease;
  }
</style>
