---
import Section from "../ui/Section.astro";
import ProjectCard from "../ui/ProjectCard.astro";
import { projects, type ProjectStatus } from "../../data/projects";

const filters: { value: "all" | ProjectStatus; label: string }[] = [
  { value: "all", label: "All" },
  { value: "shipped", label: "Shipped" },
  { value: "in progress", label: "In Progress" },
];
---

<Section id="projects" index="02" label="projects" title="What I've Built">
  <div class="mb-8 flex flex-wrap gap-3" role="group" aria-label="Filter projects" data-reveal>
    {
      filters.map((filter, i) => (
        <button
          type="button"
          data-filter={filter.value}
          aria-pressed={i === 0 ? "true" : "false"}
          class="border border-border px-4 py-2 font-mono text-xs tracking-[0.15em] text-muted uppercase transition-colors duration-300 hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent"
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" id="project-grid">
    {
      projects.map((project, i) => (
        <li data-status={project.status} data-reveal>
          <ProjectCard project={project} index={i + 1} />
        </li>
      ))
    }
  </ul>
  <p id="project-count" class="sr-only" aria-live="polite"></p>
</Section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>("#project-grid > li");
  const status = document.getElementById("project-count");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));

      let shown = 0;
      items.forEach((item) => {
        const match = filter === "all" || item.dataset.status === filter;
        item.hidden = !match;
        if (match) {
          shown++;
          // Cards revealed by a filter change are already on screen — show them immediately.
          item.classList.add("is-visible");
        }
      });
      if (status) status.textContent = `Showing ${shown} project${shown === 1 ? "" : "s"}`;
    });
  });
</script>
